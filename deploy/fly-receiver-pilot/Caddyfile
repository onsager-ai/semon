{
	# Fly terminates public TLS and forwards HTTPS traffic to this private ingress.
	# Do not log request headers, paths, or bodies; Authorization and pairing data are sensitive.
	auto_https off
	log {
		output discard
	}
}

http://{$PUBLIC_HOST}:8080 {
	@sender_post {
		method POST
		path /v1/pair /v1/unpair /v1/push/append /v1/push/facts /v1/push/status
	}
	@status_probe {
		method HEAD
		path /v1/push/status
	}

	handle @sender_post {
		reverse_proxy 127.0.0.1:8735 {
			header_up Host {http.request.host}
		}
	}
	handle @status_probe {
		reverse_proxy 127.0.0.1:8735 {
			header_up Host {http.request.host}
		}
	}

	# No other path or method, including every Viewer and management route, is public.
	handle {
		respond "Not Found" 404
	}
}
