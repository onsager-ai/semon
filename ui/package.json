{
  "name": "semon-ui",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "check:bundle": "node build.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "sizes": "node build.mjs --sizes",
    "format": "node format.mjs --write",
    "format:check": "node format.mjs",
    "hooks:install": "node hooks.mjs install",
    "hooks:remove": "node hooks.mjs remove"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "6.0.3"
  }
}
