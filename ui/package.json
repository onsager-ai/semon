{
  "name": "semon-ui",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --output-dir ../tests/ui/storybook-static",
    "check:bundle": "node build.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "sizes": "node build.mjs --sizes",
    "format": "node format.mjs --write",
    "format:check": "node format.mjs",
    "hooks:install": "node hooks.mjs install",
    "hooks:remove": "node hooks.mjs remove",
    "check:architecture": "node architecture-check.mjs",
    "check:design": "node design-check.mjs"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@storybook/preact-vite": "10.6.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.6.2",
    "storybook": "10.6.0",
    "typescript": "6.0.3"
  }
}
