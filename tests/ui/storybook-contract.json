    },
    {
      "id": "machines",
      "modules": ["../src/lib/screens"],
      "storyIds": ["semon-production-owners--machines"],
      "servedChecks": ["visual-pixels", "functional-checks"]
    },
    {
      "id": "analytics",
      "modules": ["../src/lib/analytics"],
      "storyIds": ["semon-production-owners--analytics-states"],
      "servedChecks": ["visual-pixels", "served-overview"]
