  "visualCoverage": {
    "source": "visual-coverage.json",
    "servedCheck": "visual-pixels",
    "storyRules": [
      { "pattern": "^analytics$", "storyIds": ["semon-production-owners--analytics-states"] },
      { "pattern": "^home$", "storyIds": ["semon-production-owners--home"] },
      { "pattern": "^machines?$|^machine-", "storyIds": ["semon-production-owners--machines"] },
      { "pattern": "^session-", "storyIds": ["semon-production-owners--compact-reader", "semon-production-owners--failure-inspection"] },
      { "pattern": "^sessions$", "storyIds": ["semon-production-owners--sessions-catalog"] },
      { "pattern": "^trace-", "storyIds": ["semon-production-owners--trace-empty"] },
      { "pattern": "^drawer$", "storyIds": ["semon-production-owners--component-gallery"] }
    ]
  },
  "preservation": {
    "source": "preservation-contract.mjs",
    "servedCheck": "preservation"
  },
  "visualAcceptance": {
    "source": "visual-acceptance.json",
