    {
      "id": "session-menu",
      "modules": ["../src/lib/session-menu"],
      "storyIds": ["semon-production-owners--session-menu"],
      "servedChecks": ["functional-checks"]
    },
    {
      "id": "shared-panels-sheets-controls",
      "modules": ["../src/lib/panel", "../src/lib/sheets", "../src/lib/tooltip"],
      "storyIds": ["semon-production-owners--component-gallery"],
      "servedChecks": ["component-gallery", "functional-checks"]
    },
    {
      "id": "loading-empty-error-focus",
      "modules": ["../src/lib/catalog", "../src/lib/screens"],
      "storyIds": [
        "semon-production-owners--catalog-loading",
        "semon-production-owners--catalog-empty",
        "semon-production-owners--catalog-failure",
        "semon-production-owners--loading-empty-error",
        "semon-production-owners--keyboard-focus"
      ],
      "servedChecks": ["visual-pixels", "preservation", "functional-checks"]
    }
